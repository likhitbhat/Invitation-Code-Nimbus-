{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "index.js": {
      "includeFiles": "dist/**"
    },
    "server.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|media/|favicons/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
